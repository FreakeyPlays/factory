{
  "name": "@factory/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/public-api.ts",
    "./src/styles.css": "./src/styles.css",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "ng build ui",
    "typecheck": "tsc -p ./tsconfig.spec.json --noEmit && tsc -p .storybook/tsconfig.json --noEmit",
    "test": "ng test --watch=false",
    "test:visual": "vitest run",
    "test:visual:update": "vitest run --update",
    "storybook": "ng run ui:storybook"
  },
  "dependencies": {
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@angular/build": "catalog:angular",
    "@angular/cli": "catalog:angular",
    "@angular/common": "catalog:angular",
    "@angular/compiler": "catalog:angular",
    "@angular/compiler-cli": "catalog:angular",
    "@angular/core": "catalog:angular",
    "@angular/platform-browser": "catalog:angular",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/angular-vite": "10.6.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/bun": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "ng-packagr": "catalog:angular",
    "playwright": "catalog:",
    "postcss": "^8.5.3",
    "storybook": "^10.6.0",
    "storybook-addon-vis": "^4.2.7",
    "tailwindcss": "^4.1.12",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@angular/common": "catalog:angular",
    "@angular/core": "catalog:angular",
    "rxjs": "catalog:angular"
  }
}
